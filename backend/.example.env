# ---------------------------------------------------------------- database
# Supabase transaction pooler (port 6543) — used by the app.
DATABASE_URL="postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Session mode (port 5432) — used by Alembic. Schema changes cannot run
# over the transaction pooler.
DIRECT_DATABASE_URL="postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------- supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ------------------------------------------------------------------ voice ai
GROQ_API_KEY=<your groq api key>
NVIDIA_API_KEY=<your nvidia api key>
KOKORO_VOICE=af_heart

# ---------------------------------------------------------------- telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_HOST=

# ---------------------------------------------------------------------- app
SECRET_KEY=change-this-to-something-random
FRONTEND_URL=http://localhost:3000
DEBUG=true
