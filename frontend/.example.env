# Copy to .env.local and fill in.

# ---------------------------------------------------------------- backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# The voice WebSocket. With no ?phone= the browser behaves like a call from an
# unknown number (the agent asks for a name). Append ?phone=<seeded number> to
# simulate a known caller arriving with caller ID.
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:8000/api/ws/voice

# ------------------------------------------------- supabase realtime (read-only)
# Live doctor availability is pushed straight to the browser. RLS allows anon
# SELECT on `doctors` and `doctor_status` only, so the publishable key is safe
# to ship to the client. Without these the dashboards still work — they just
# don't update on their own.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
